# Copy to .env and fill in values
APP_ENV=development
APP_ADDR=:8080
DATABASE_URL=postgres://seed:seed@localhost:5432/seed?sslmode=disable
JWT_SECRET=change-me-at-least-32-chars-long!!
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Storage (MinIO locally, R2 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=seed
STORAGE_SECRET_KEY=seed-dev-secret
STORAGE_BUCKET=seed-assets

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_FROM=MyApp <noreply@myapp.com>
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-key

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret

# LLM — Anthropic direct
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_CAPABLE_MODEL=claude-sonnet-4-6

# LLM — Ollama (optional local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3:0.6b
OLLAMA_CAPABLE_MODEL=qwen3:8b

# Sidecar
SIDECAR_URL=http://localhost:3001

# Admin
ADMIN_EMAIL=admin@example.com

# Deployment (set in GitHub Secrets, not here)
# FLY_API_TOKEN
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# NEXT_PUBLIC_API_URL=https://project-seed-api.fly.dev
